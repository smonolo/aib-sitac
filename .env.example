PORT=4000
# Comma-separated allowlist. Required (explicit) when NODE_ENV=production.
# Local:
CORS_ORIGIN=http://localhost:3000
# Production example:
# CORS_ORIGIN=https://aib-sitac.smnl.dev
# Behind a reverse proxy, set to 1 (or hop count) so rate limits see the real client IP.
# TRUST_PROXY=1
# JSON_BODY_LIMIT=256kb
# DB_POOL_MAX=20

NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
